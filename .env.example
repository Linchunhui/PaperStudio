# run.py loads literal KEY=value from .env; the process environment takes priority.
# No shell commands or variable interpolation are executed. Keep this file private.
PAPERSTUDIO_DATA_DIR=./data
PAPERSTUDIO_HOST=127.0.0.1
PAPERSTUDIO_PORT=8000
PAPERSTUDIO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PAPERSTUDIO_TRUSTED_PROXIES=127.0.0.1
# Set to 1 when deployed behind HTTPS. Keep 0 for local plain HTTP.
PAPERSTUDIO_COOKIE_SECURE=0
# Optional first-admin token; otherwise data/bootstrap-token is generated securely.
# PAPERSTUDIO_SETUP_TOKEN=
PAPERSTUDIO_SEED_DEMO=0
# Start reading without a model. Configure it later in the admin settings UI.
# Existing deployments keep their .env; copying this file is not an upgrade step.
AI_PROVIDER=none
AI_MODEL=
CODEX_BIN=codex
AI_TIMEOUT_SECONDS=600
AI_MAX_INPUT_CHARS=400000
AI_MAX_OUTPUT_TOKENS=16384
# Alternative: AI_PROVIDER=openai with your compatible endpoint and credentials.
AI_BASE_URL=
AI_API_KEY=
# Optional BabelDOC executable; see README before enabling.
BABELDOC_BIN=babeldoc
BABELDOC_PARSE_TIMEOUT_SECONDS=900
BABELDOC_TIMEOUT_SECONDS=1800
# babeldoc is preferred; if unavailable/incompatible, the text-layer fallback is labelled.
PAPERSTUDIO_PARSER=babeldoc

# Full-web search: configure one provider. arXiv/HF academic search is separate.
SEARCH_PROVIDER=
SEARXNG_BASE_URL=
# Or SEARCH_PROVIDER=brave and set the server-side subscription token.
BRAVE_API_KEY=


# Source installs preserve the full bundled catalogue by default.
# Set light to skip first-start catalogue loading (existing data is never removed).
PAPERSTUDIO_CATALOG_MODE=full
# Optional: lock UI model configuration to deployment environment.
# PAPERSTUDIO_MODEL_CONFIG=environment
